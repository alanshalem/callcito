// ============================================================
// #region Generator & Datasource
// ============================================================
// Cliente Prisma generado a node_modules/.prisma/client.
generator client {
  provider = "prisma-client-js"
}

// Prisma 7: `url` vive en prisma.config.ts, no acá.
datasource db {
  provider = "postgresql"
}

// ============================================================
// #region Enums
// ============================================================
enum UserRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
}

enum ConversationStatus {
  ACTIVE
  ENDED
  ABANDONED
}

// ============================================================
// #region Core: Users + Companies + Membership (Clerk Orgs)
// ============================================================
model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkId      String       @unique
  email        String       @unique
  name         String
  profileImage String?
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([email])
  @@index([clerkId])
}

model Company {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkOrgId      String        @unique
  name            String
  slug            String        @unique
  logoUrl         String?
  currency        String        @default("ARS")
  country         String        @default("AR")
  defaultLanguage String        @default("es")
  mpAccessToken   String?       @db.Text
  mpUserId        String?
  platformFeeBps  Int           @default(0)
  customDomain    String?       @unique
  memberships     Membership[]
  catalogs        Catalog[]
  assistants      Assistant[]
  subscription    Subscription?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clerkOrgId])
}

model Membership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  role      UserRole @default(EDITOR)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}

// ============================================================
// #region Catalog + Product
// ============================================================
model Catalog {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String     @db.Uuid
  name        String
  slug        String
  description String?
  isPublished Boolean    @default(false)
  assistantId String?    @db.Uuid
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assistant   Assistant? @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
}

model Product {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogId   String     @db.Uuid
  sku         String?
  name        String
  description String?    @db.Text
  price       Decimal    @db.Decimal(12, 2)
  currency    String     @default("ARS")
  stock       Int?
  images      String[]
  tags        String[]
  isActive    Boolean    @default(true)
  catalog     Catalog    @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([catalogId])
  @@index([sku])
  @@index([isActive])
}

// ============================================================
// #region AI Assistant (Vapi-backed) + Conversation
// ============================================================
model Assistant {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String         @db.Uuid
  name            String
  language        String         @default("es")
  voiceId         String
  firstMessage    String         @db.Text
  systemPrompt    String         @db.Text
  systemPromptB   String?        @db.Text
  vapiAssistantId String?
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  catalogs        Catalog[]
  conversations   Conversation[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId])
}

model Conversation {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assistantId    String             @db.Uuid
  catalogId      String             @db.Uuid
  customerEmail  String?
  customerPhone  String?
  status         ConversationStatus @default(ACTIVE)
  vapiCallId     String?            @unique
  transcript     Json?
  durationSec    Int?
  promptVariant  String?
  assistant      Assistant          @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  cart           Cart?
  startedAt      DateTime           @default(now())
  endedAt        DateTime?

  @@index([assistantId])
  @@index([catalogId])
  @@index([status])
  @@index([startedAt])
}

// ============================================================
// #region Cart + Order (MercadoPago-backed)
// ============================================================
model Cart {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @unique @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  items          CartItem[]
  order          Order?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model CartItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int     @default(1)
  priceSnap Decimal @db.Decimal(12, 2)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([cartId])
}

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId         String      @unique @db.Uuid
  cart           Cart        @relation(fields: [cartId], references: [id])
  mpPreferenceId String?
  mpPaymentId    String?
  mpCheckoutUrl  String?
  totalAmount    Decimal     @db.Decimal(12, 2)
  currency       String
  status         OrderStatus @default(PENDING)
  customerEmail  String?
  payerInfo      Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([mpPreferenceId])
}

// ============================================================
// #region SaaS Billing: Plan + Subscription
// ============================================================
model Plan {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tier             PlanTier       @unique
  name             String
  priceArs         Decimal        @db.Decimal(12, 2)
  maxCatalogs      Int
  maxProducts      Int
  maxAssistants    Int
  maxConversations Int
  features         Json
  mpPlanId         String?
  subscriptions    Subscription[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Subscription {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String             @unique @db.Uuid
  planId           String             @db.Uuid
  mpPreapprovalId  String?            @unique
  status           SubscriptionStatus @default(PENDING)
  currentPeriodEnd DateTime?
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan             Plan               @relation(fields: [planId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([planId])
  @@index([status])
}
